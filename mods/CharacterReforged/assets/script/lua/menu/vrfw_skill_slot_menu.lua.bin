  GRAPH_LAYERS = function(value) GRAPH_LAYERS = value end,
  character_reforged_detail_on = function(value) character_reforged_detail_on = value end,
  DetailLevelTab = function(value) DetailLevelTab = value end,
  RetailOnSetupLayer = function(value) RetailOnSetupLayer = value end,
  RetailOnOpenLayer = function(value) RetailOnOpenLayer = value end,
  RetailOnFunction = function(value) RetailOnFunction = value end,
  RetailOnBack = function(value) RetailOnBack = value end,
  character_reforged_cursor_idx = function(value) character_reforged_cursor_idx = value end,
  RetailOnChangeFocus = function(value) RetailOnChangeFocus = value end,
  BoardPut = function(value) BoardPut = value end,
  BoardClear = function(value) BoardClear = value end,
  ListPut = function(value) ListPut = value end,
  Log = function(value) Log = value end,
  TeamAuraPut = function(value) TeamAuraPut = value end,
  Report = function(value) Report = value end,
  Snapshot = function(value) Snapshot = value end,
  Diff = function(value) Diff = value end,
  HandleFor = function(value) HandleFor = value end,
  HyperHandle = function(value) HyperHandle = value end,
  CurrentWithInv = function(value) CurrentWithInv = value end,
  SetPreview = function(value) SetPreview = value end,
  STAT_TITLE = function(value) STAT_TITLE = value end,
  SetPreviewCall = function(value) SetPreviewCall = value end,
  L_PV_PANEL = function(value) L_PV_PANEL = value end,
  L_PV_ROW = function(value) L_PV_ROW = value end,
  L_BLACKBG = function(value) L_BLACKBG = value end,
  L_BTN_ICON = function(value) L_BTN_ICON = value end,
  L_BTN_SS = function(value) L_BTN_SS = value end,
  SET_PREVIEW_ROWS = function(value) SET_PREVIEW_ROWS = value end,
  BG_COUNT = function(value) BG_COUNT = value end,
  ROW_ICON_SKILL_SLOT = function(value) ROW_ICON_SKILL_SLOT = value end,
  ROW_ICON_PREVIEW = function(value) ROW_ICON_PREVIEW = value end,
  POSITION_VISIBLE = function(value) POSITION_VISIBLE = value end,
  Priority = function(value) Priority = value end,
  PRIME_INDEX = function(value) PRIME_INDEX = value end,
  PRIME_NUM = function(value) PRIME_NUM = value end,
  PRIME_VISIBLE = function(value) PRIME_VISIBLE = value end,
  NUM_LEVEL = function(value) NUM_LEVEL = value end,
  MENU_CTRL = function(value) MENU_CTRL = value end,
  COMMAND_BACK = function(value) COMMAND_BACK = value end,
  COMMAND_ENTER = function(value) COMMAND_ENTER = value end,
  COMMAND_UP = function(value) COMMAND_UP = value end,
  COMMAND_DOWN = function(value) COMMAND_DOWN = value end,
  TEXTURE_SOCCER11_20 = function(value) TEXTURE_SOCCER11_20 = value end,
  TEXTURE_ICON_COMMON = function(value) TEXTURE_ICON_COMMON = value end,
  TEXTURE_TEAMBUFF = function(value) TEXTURE_TEAMBUFF = value end,
  SKILL_SLOT_CATEGORY = function(value) SKILL_SLOT_CATEGORY = value end,
  character_reforged_pv_open = function(value) character_reforged_pv_open = value end,
  character_reforged_icon_frames = function(value) character_reforged_icon_frames = value end,
  SetPreviewTeamText = function(value) SetPreviewTeamText = value end,
  RowReset = function(value) RowReset = value end,
  ALBUM_ICON_ON = function(value) ALBUM_ICON_ON = value end,
  TEXTURE_ABILEAR = function(value) TEXTURE_ABILEAR = value end,
  ICON_SIXTH = function(value) ICON_SIXTH = value end,
  ButtonIcon = function(value) ButtonIcon = value end,
  SkillSlotIcon = function(value) SkillSlotIcon = value end,
  SkillSlotGet = function(value) SkillSlotGet = value end,
  SkillSlotLock = function(value) SkillSlotLock = value end,
  SkillSlotButtonRefresh = function(value) SkillSlotButtonRefresh = value end,
  SkillSlotInfo = function(value) SkillSlotInfo = value end,
  OpenSixSense = function(value) OpenSixSense = value end,
  ENABLE_COMMAND = function(value) ENABLE_COMMAND = value end,
  COMMAND_FCS_NEXT = function(value) COMMAND_FCS_NEXT = value end,
  SetPreviewPrevSetupLayer = function(value) SetPreviewPrevSetupLayer = value end,
  SetPreviewPrevOpenLayer = function(value) SetPreviewPrevOpenLayer = value end,
  character_reforged_focus_layer = function(value) character_reforged_focus_layer = value end,
  SetPreviewPrevChangeFocus = function(value) SetPreviewPrevChangeFocus = value end,
  SetPreviewPrevDecide = function(value) SetPreviewPrevDecide = value end,
  SetPreviewPrevFunction = function(value) SetPreviewPrevFunction = value end,
  character_reforged_ss_shown = function(value) character_reforged_ss_shown = value end,
  SetPreviewPrevStep = function(value) SetPreviewPrevStep = value end
}
do
  local SkillTable = CharacterReforged.skill_table

  function SkillTable.current()
    return CharacterReforged.skill_table == SkillTable
  end

  function SkillTable.log(...)
    local parts = {}
    for k = 1, select("#", ...) do
      parts[#parts + 1] = tostring((select(k, ...)))
    end
    pcall(funcLuaCommand, C.LOG, "CharacterReforged skill_table", table.concat(parts, " "))
  end

  -- The chunk's locals.
  SkillTable.L = setmetatable({}, {
    __index = function(_, name)
      local getter = SkillTable.get[name]
      if getter ~= nil then
        return getter()
      end
      return nil
    end,
    __newindex = function(_, name, value)
      local setter = SkillTable.set[name]
      if setter == nil then
        error("CharacterReforged.SkillTable.L: the screen has no local " .. tostring(name), 2)
      end
      setter(value)
    end,
  })

  -- Returns an _ENV for code written as if it were appended to this chunk.
  function SkillTable.env(globals)
    return setmetatable({}, {
      __index = function(_, name)
        local getter = SkillTable.get[name]
        if getter ~= nil then
          return getter()
        end
        return globals[name]
      end,
      __newindex = function(_, name, value)
        local setter = SkillTable.set[name]
        if setter ~= nil then
          setter(value)
        else
          globals[name] = value
        end
      end,
    })
  end

  function SkillTable.text(id)
    local ok, s = pcall(funcLuaCommand, SkillTable.TEXT_GET, id)
    return (ok and type(s) == "string") and s or ""
  end

  -- Returns the text id of a text row name (an entry's `text`).
  function SkillTable.text_id(name)
    if type(name) == "number" then
      return name
    end
    if type(name) ~= "string" or name == "" or type(CRC32) ~= "function" then
      return 0
    end
    local ok, id = pcall(CRC32, name)
    return (ok and type(id) == "number") and id or 0
  end

  function SkillTable.resolve(path)
    local value = _ENV
    for part in string.gmatch(path or "", "[^%.]+") do
      if type(value) ~= "table" then
        return nil
      end
      value = rawget(value, part)
    end
    return type(value) == "function" and value or nil
  end

  -- Returns the declared entries of one host, in order.
  function SkillTable.host_entries(host)
    SkillTable.entries = SkillTable.entries or {}
    local cached = SkillTable.entries[host]
    if cached ~= nil then
      return cached
    end
    local out = {}
    local menu = rawget(VRFW, "menu")
    if type(menu) == "table" and type(menu.entries) == "function" then
      local ok, list = pcall(menu.entries, host)
      if ok and type(list) == "table" then
        for _, e in ipairs(list) do
          if e.kind == "lua" and type(e.value) == "string" and e.value ~= "" then
            out[#out + 1] = {key = e.key or e.value, text = e.text, path = e.value}
          end
        end
      end
    end
    SkillTable.entries[host] = out
    if #out > 0 then
      local keys = {}
      for _, e in ipairs(out) do
        keys[#keys + 1] = e.key
      end
      SkillTable.log("host", host, "entries", table.concat(keys, ", "))
    end
    return out
  end

  function SkillTable.log_once(what, ...)
    if not SkillTable.logged[what] then
      SkillTable.logged[what] = true
      SkillTable.log(what, ...)
    end
  end

  -- Calls f(phase, ctx) of an entry, protected.
  function SkillTable.call(entry, phase, ctx)
    local fn = SkillTable.resolve(entry.path)
    if fn == nil then
      SkillTable.log_once("missing " .. entry.path, "entry", entry.key, "function", entry.path, "is not defined in this menu")
      return nil
    end
    local ok, answer = pcall(fn, phase, ctx)
    if not ok then
      SkillTable.log_once("failed " .. entry.key .. " " .. phase, "entry", entry.key, phase, "failed:", tostring(answer))
      return nil
    end
    return answer
  end

  function SkillTable.chara()
    return n
  end

  function SkillTable.move_name(skill)
    return Name(skill)
  end

  -- "ok" / "decide" / "back" / "refused" / "remove"
  function SkillTable.sound(kind)
    local id = ({ok = SE_OK, decide = SE_DECIDE, back = SE_BACK, refused = SE_NG, remove = SE_REMOVE})[kind]
    if id ~= nil then
      pcall(funcLuaCommand, C.SE, id)
    end
  end

  -- the rows, the player card, the radar and the guide after a change of the shown player's moves
  function SkillTable.refresh()
    pcall(CharacterReforged.skill_table_after_change)
  end

  function SkillTable.focused_row()
    if n14 == L_BTN then
      return nil
    end
    local row = funcLuaMenuCommand(C.FOCUS_IDX, L_ROW)
    if row == nil or row < 0 or row >= ROW_NUM or CharacterReforged.skill_table_is_locked(row) then
      return nil
    end
    return row, to_u32(PL.row_move(row) or 0)
  end

  function SkillTable.row_context(entry)
    local row, move = SkillTable.focused_row()
    if row == nil then
      return nil
    end
    return {key = entry.key, chara = n, row = row, slot = row, move = move}
  end

  function SkillTable.row_action(host)
    host = host or SkillTable.ROW_HOST
    for _, entry in ipairs(SkillTable.host_entries(host)) do
      local ctx = SkillTable.row_context(entry)
      if ctx == nil then
        return nil
      end
      if SkillTable.call(entry, "available", ctx) == true then
        return entry, ctx
      end
    end
    return nil
  end

  SkillTable.previous_on_function = OnFunction
  function OnFunction(a1, a2)
    local host = (a1 == SkillTable.ROW_KEY_FUNCTION and SkillTable.ROW_HOST)
      or (a1 == SkillTable.X_KEY_FUNCTION and SkillTable.X_HOST) or nil
    if SkillTable.current() and host ~= nil and vrfw_co == nil then
      local entry, ctx = SkillTable.row_action(host)
      if entry ~= nil then
        local fn = SkillTable.resolve(entry.path)
        SkillTable.log(host == SkillTable.X_HOST and "x action" or "row action", entry.key, "row", ctx.row, "move",
          string.format("%08X", ctx.move))
        vrfw_co = coroutine.create(function()
          fn("press", ctx)
        end)
        return
      end
    end
    return SkillTable.previous_on_function(a1, a2)
  end

  -- Adds row guides (PL.row_guide and the combo partners' guide call PL.mx_guide_add).
  function SkillTable.guide_add(host, glyph, key, t, i, c, o)
    local ok, entry, ctx = pcall(SkillTable.row_action, host)
    if not ok or entry == nil or SkillTable.call(entry, "guide", ctx) == false then
      return
    end
    local text = SkillTable.text_id(entry.text)
    if text == 0 then
      return
    end
    local k = #t + 1
    t[k], i[k], c[k], o[k] = text, glyph, key, 18
  end

  SkillTable.previous_guide_add = PL.mx_guide_add
  function PL.mx_guide_add(t, i, c, o)
    if SkillTable.previous_guide_add ~= nil then
      SkillTable.previous_guide_add(t, i, c, o)
    end
    if not SkillTable.current() then
      return
    end
    SkillTable.guide_add(SkillTable.ROW_HOST, PL.I_FUNC1, PL.K_FUNC1, t, i, c, o)
    SkillTable.guide_add(SkillTable.X_HOST, PL.I_FUNC4, PL.K_FUNC4, t, i, c, o)
  end

  function SkillTable.button()
    local list = SkillTable.host_entries(SkillTable.BUTTON_HOST)
    if #list > 1 then
      local others = {}
      for k = 2, #list do
        others[#others + 1] = list[k].key
      end
      SkillTable.log_once("button room", "footer button: one slot,", list[1].key, "has it;", table.concat(others, ", "),
        "not shown")
    end
    return list[1]
  end

  function SkillTable.button_context(entry)
    return {key = entry.key, chara = n}
  end

  -- the button's label (the entry's text) and, while it has the focus, the guide line its function gives
  function SkillTable.button_refresh()
    local entry = SkillTable.button()
    local layer = SkillTable.BUTTON_LAYER
    if entry == nil then
      funcLuaMenuCommand(C.LAYER_VISIBLE, layer, 0, false)
      return
    end
    funcLuaMenuCommand(C.TEXT, layer, SkillTable.BUTTON_LABEL_NODE, SkillTable.text(SkillTable.text_id(entry.text)), 0)
    funcLuaMenuCommand(C.TEXT, layer, SkillTable.BUTTON_KEY_NODE, "", 0)
    if character_reforged_focus_layer == layer then
      local line = SkillTable.call(entry, "guide", SkillTable.button_context(entry))
      if type(line) == "string" then
        funcLuaMenuCommand(C.TEXT, SkillTable.GUIDE_LINE_LAYER, SkillTable.GUIDE_LINE_NODE, line, 0)
      end
    end
  end

  SkillTable.previous_setup_layer = OnSetupLayer
  function OnSetupLayer(a1, a2, ...)
    if a1 == SkillTable.BUTTON_LAYER and SkillTable.current() then
      pcall(SkillTable.button_refresh)
      funcLuaMenuCommand(1774843228 --[[CMND_SET_LAYER_ATTACH_LOCATOR_TRACE?]], a1, a2, 3313461902 --[[cursor]], false)
      return
    end
    return SkillTable.previous_setup_layer(a1, a2, ...)
  end

  SkillTable.previous_open_layer = OnOpenLayer
  function OnOpenLayer(a1, a2, ...)
    if a1 == SkillTable.BUTTON_LAYER and SkillTable.current() then
      funcLuaMenuCommand(3781155141 --[[CMND_PLAY_ANIME_TYPE]], a1, a2, 2734777837 --[[Focus]], 2, 973515837 --[[button]])
      pcall(SkillTable.button_refresh)
      return
    end
    return SkillTable.previous_open_layer(a1, a2, ...)
  end

  SkillTable.previous_change_focus = OnChangeFocus
  function OnChangeFocus(a1, a2, ...)
    if a1 == SkillTable.BUTTON_LAYER and SkillTable.current() then
      character_reforged_focus_layer = a1
      n14 = L_BTN                                    -- the screen treats it like the bottom button (no row info)
      pcall(UpdateEquipItemInfo)
      pcall(SkillTable.button_refresh)
      return
    end
    return SkillTable.previous_change_focus(a1, a2, ...)
  end

  SkillTable.previous_decide_focus = OnDecideFocus
  function OnDecideFocus(a1, a2, ...)
    if a1 == SkillTable.BUTTON_LAYER and SkillTable.current() then
      local entry = SkillTable.button()
      if entry ~= nil and vrfw_co == nil then
        local fn = SkillTable.resolve(entry.path)
        if fn == nil then
          SkillTable.sound("refused")
          SkillTable.log_once("missing " .. entry.path, "entry", entry.key, "function", entry.path, "is not defined in this menu")
          return
        end
        local ctx = SkillTable.button_context(entry)
        SkillTable.log("footer button", entry.key, "pressed", "chara", tostring(n))
        vrfw_co = coroutine.create(function()
          fn("press", ctx)
        end)
      end
      return
    end
    return SkillTable.previous_decide_focus(a1, a2, ...)
  end

  -- The list popups (sets, role, custom passive) cover the bottom buttons.
  if PL ~= nil and PL.list_cover ~= nil then
    SkillTable.previous_list_cover = PL.list_cover
    function PL.list_cover(show, ...)
      local result = SkillTable.previous_list_cover(show, ...)
      if SkillTable.current() then
        funcLuaMenuCommand(C.LAYER_VISIBLE, SkillTable.BUTTON_LAYER, 0, (not show) and SkillTable.button() ~= nil)
      end
      return result
    end
  end

  -- a new visit of the screen reads the declarations again
  SkillTable.previous_init = OnInit
  function OnInit(...)
    if SkillTable.current() then
      SkillTable.entries = nil
    end
    return SkillTable.previous_init(...)
  end
end
-- ===== EVT skill_table_host END =====
