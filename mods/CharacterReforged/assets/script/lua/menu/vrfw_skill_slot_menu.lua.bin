function PL.list_cover(show)
  funcLuaMenuCommand(C.LAYER_VISIBLE, PL.L_LISTBG, 0, show)
  if show then
    funcLuaMenuCommand(C.SPRITE, PL.L_LISTBG, 2311471971 --[[cmn02_01.g4tx]], 515167937 --[[bg_blue01]],
      3512665951 --[[bg_black00]], 0, 0)
  end
  funcLuaMenuCommand(C.LAYER_VISIBLE, 1774956026 --[[team00_01_chara_card]], 0, not show)
  for _, L in ipairs({L_BTN, L_BTN_SS, PL.L_BTN_ROLE}) do
    funcLuaMenuCommand(C.LAYER_VISIBLE, L, 0, not show)
  end
  for _, k in ipairs({ROW_ICON_SKILL_SLOT, PL.ROW_ICON_ROLE}) do
    funcLuaMenuCommand(C.LAYER_VISIBLE, L_PV_ROW, k, not show)
  end
  funcLuaMenuCommand(C.MESH_VISIBLE, L_BASE, 785322415, not show, 0)
end

function PL.ss_list_show(show, list, first, sel)
  if not show then
    for k in pairs(PL.row_split) do
      pcall(PL.row_full, PL.L_SSROW, k)
    end
  end
  local file_btn_was = PL.file_btn_shown              -- the export / import buttons (PL.vrm_row) redraw below
  PL.file_btn_shown = false
  if show ~= PL.list_covered then
    PL.list_covered = show
    pcall(PL.list_cover, show)
  end
  local LL, RL, NR = PL.list_layers(PL.list_mode)    -- a mode's own frame / rows (combo partners)
  PL.open(LL)
  funcLuaMenuCommand(C.LAYER_VISIBLE, LL, 0, show)
  for k = 0, NR - 1 do
    local e = show and list[first + k + 1] or nil
    if e ~= nil then
      if PL.list_mode ~= nil then
        PL.list_mode.row(k, e, first + k == sel)
      else
        PL.ss_row(k, e, first + k == sel)
      end
    end
    PL.open(RL, k)
    funcLuaMenuCommand(C.LAYER_VISIBLE, RL, k, e ~= nil)
  end
  pcall(PL.list_arrows, show, first, NR, #list, LL)   -- scroll arrows (the combo partner list)
  for r = 0, ROW_NUM - 1 do                  -- the list covers the left column: the mod's rows go away meanwhile
    funcLuaMenuCommand(C.LAYER_VISIBLE, L_ROW, r, not show)
  end
  funcLuaMenuCommand(C.LAYER_VISIBLE, L_CURSOR, 0, not show)
  if file_btn_was and not PL.file_btn_shown then
    PL.file_btn_shown = true
    pcall(PL.file_btn_hide)
  end
  if show then
    pcall(funcLuaMenuCommand, C.CURSOR_LOC, RL, 3313461902 --[[cursor]], sel - first, NR)
    if PL.file_btn_shown then
      local se = list[sel + 1]
      if se ~= nil and se.kind == "vrm" then
        pcall(PL.file_btn_cursor, RL, NR)
      else
        pcall(funcLuaMenuCommand, C.CURSOR_LOC, PL.FILE_BTN.L, 3313461902 --[[cursor]], 2, 2)
      end
    end
  end
  if show and PL.list_mode ~= nil then
    local e = list[sel + 1]
    if PL.list_mode.focus ~= nil and e ~= nil then
      pcall(PL.list_mode.focus, e)
    else
      pcall(CharacterReforged.skill_table_detail_hide)
    end
    PL.guide(PL.list_mode.guide or "")
  elseif show then
    local e = list[sel + 1]
    if e ~= nil and e.id ~= 0 then
      pcall(PL.passive_detail, e.name, e.desc or "", e.id)
    else
      pcall(CharacterReforged.skill_table_detail_hide)
    end
    PL.guide(PL.txt(2241341507 --[[skill_table_passive_list_guide]]))
  end
end

function PL.ss_list(list, init)
  local sel = math.max(0, math.min(#list - 1, init or 0))
  local first = math.max(0, math.min(sel, #list - PL.SSROWS))
  PL.ss_list_show(true, list, first, sel)
  coroutine.yield()
  local function key(k)
    return funcLuaCommand(4265778440, MENU_CTRL, k)
      or funcLuaCommand(4265778440, 2748927068 --[[MENU_CTRL_WITH_ANALOG_MOVE_FOCUS]], k)
  end
  local result = -1
  local P = PL.ptr_start()
  while true do
    coroutine.yield()
    local pact, pfirst, psel, owns = PL.ptr_step(P, PL.L_SSROW, PL.SSROWS, PL.PTR_SS, first, sel, #list)
    if pact == "pick" then
      first, sel = pfirst, psel                    -- the clicked row is the one decided
    end
    if key(COMMAND_BACK) then
      funcLuaCommand(C.SE, SE_BACK)
      break
    elseif pact == "pick" or (not owns and (key(COMMAND_ENTER) or key(1651523701 --[[CMD_ENTER_CLICK]]))) then
      if PL.list_mode ~= nil and PL.list_mode.stay ~= nil and PL.list_mode.stay(list[sel + 1]) then
        PL.ss_list_show(true, list, first, sel)      -- toggled (miximax move choice), the list stays
      else
        result = sel
        break
      end
    elseif key(COMMAND_DOWN) and sel < #list - 1 then
      sel = sel + 1
      if sel >= first + PL.SSROWS then
        first = first + 1
      end
      funcLuaCommand(C.SE, 2500047763 --[[sy0005 cursor]])
      PL.ss_list_show(true, list, first, sel)
    elseif key(COMMAND_UP) and sel > 0 then
      sel = sel - 1
      if sel < first then
        first = first - 1
      end
      funcLuaCommand(C.SE, 2500047763)
      PL.ss_list_show(true, list, first, sel)
    elseif pact == "moved" then
      first, sel = pfirst, psel
      funcLuaCommand(C.SE, 2500047763)
      PL.ss_list_show(true, list, first, sel)
    end
  end
  PL.ss_list_show(false, list, first, sel)
  coroutine.yield()                              -- the closing input must not reach the mod's menu
  RefreshRows()
  return result
end

function CharacterReforged.skill_slot_pick_coroutine()
  if PL.signature() ~= nil then                  -- Signature Passives: read only (the detail shows on focus)
    funcLuaCommand(C.SE, SE_NG)
    pcall(SkillSlotInfo)
    return
  end
  local locked, need, piece = SkillSlotLock()
  if locked then
    funcLuaCommand(C.SE, SE_NG)
    VRFW.question.notice(PL.txt(PL.TX.LOADER))
    return
  end
  if not PL.has_service("six_sense") then
    funcLuaCommand(C.SE, SE_NG)
    VRFW.question.notice(PL.txt(PL.TX.LOADER))
    return
  end
  funcLuaMenuCommand(C.MENU_ACTIVE, EVT_MENU, false)
  funcLuaCommand(C.SE, SE_DECIDE)
  local _, cur = SkillSlotGet()
  local list, init = {}, 0
  for _, id in ipairs(PL.SS_ITEMS) do
    local num = funcLuaCommand(PL.ITEM_NUM, id)
    if type(num) == "number" and num > 0 then
      local name = funcLuaCommand(1883585771, id, 0)
      local eff = SetPreviewCall(SetPreview.PASSIVE, 0, id)
      local e = {id = id, equipped = id == cur,
        name = type(name) == "string" and name or string.format("%08X", id),
        desc = eff ~= nil and SetPreviewTeamText(id, eff, 1) or ""}
      e.text = e.desc                                -- the row shows the effect (PL.ss_row)
      if e.equipped then
        init = #list
      end
      list[#list + 1] = e
    end
  end
  if cur ~= 0 then
    list[#list + 1] = {id = 0, name = PL.txt(PL.TX.SS_QUIT)}
  end
  if #list == 0 then
    funcLuaCommand(C.SE, SE_NG)
    VRFW.question.notice(PL.txt(PL.TX.SS_NONE))
    funcLuaMenuCommand(C.MENU_ACTIVE, EVT_MENU, true)
    return
  end
  -- Uses the role picker's retail list window (PL.pop_list).
  PL.header_title(PL.txt(PL.TX.PASSIVE))
  local pick = PL.pop_list(list, init, {
    row = PL.ss_row, focus = PL.ss_focus,
    guide = PL.txt(PL.TX.SS_GUIDE),
    keys = function()
      return {{text = PL.TX.BTN_SELECT, icon = PL.I_ENTER, cmd = PL.K_ENTER, act = "pick"}}
    end,
    act = function()
      return "close"
    end})
  PL.header_title(nil)
  if pick >= 0 then
    local e = list[pick + 1]
    local st, now
    if e.id == 0 then
      st, now = Call(8065085, n, 1, 0, -1)
      funcLuaCommand(C.SE, st == 1 and SE_REMOVE or SE_NG)
    elseif e.id ~= cur then
      local h, why = PL.free_handle(e.id)
      if h == 0 then
        funcLuaCommand(C.SE, SE_NG)                -- error sound only
        Log("sixsense no handle", tostring(why))
      else
        st, now = Call(8065085, n, 1, h, piece or -1)
        funcLuaCommand(C.SE, st == 1 and SE_DECIDE or SE_NG)   -- no status popup
      end
    end
    Call(C.LOG, "skill_slots", "sixsense set", e.id, "status", st, "now", now)
  end
  SkillSlotButtonRefresh()
  pcall(SkillSlotInfo)
  funcLuaMenuCommand(C.MENU_ACTIVE, EVT_MENU, true)
end

PL.ssl_prev_setup_layer = OnSetupLayer
function OnSetupLayer(a1, a2)
  if a1 == PL.L_LISTBG then
    funcLuaMenuCommand(Priority, a1, a2, 449, true)
    funcLuaMenuCommand(C.LAYER_VISIBLE, a1, a2, false)
    return
  elseif a1 == PL.L_SSLIST then
    funcLuaMenuCommand(Priority, a1, a2, 450, true)
    for _, pos in ipairs({1839509013 --[[_pos_scr_base01]], 1060758565 --[[_pos_scr_obj01]]}) do
      funcLuaMenuCommand(POSITION_VISIBLE, a1, pos, false, a2)
    end
    funcLuaMenuCommand(C.MESH_VISIBLE, a1, 3660005257 --[[_text_list_empty01]], false, a2)
    funcLuaMenuCommand(C.LAYER_VISIBLE, a1, a2, false)
    return
  elseif a1 == PL.L_SSROW then
    funcLuaMenuCommand(Priority, a1, a2, 451, true)
    funcLuaMenuCommand(C.LAYER_VISIBLE, a1, a2, false)
    return
  elseif a1 == PL.FILE_BTN.L then
    funcLuaMenuCommand(Priority, a1, a2, 452, true)   -- the export / import buttons over their list row
    funcLuaMenuCommand(C.LAYER_VISIBLE, a1, a2, false)
    pcall(funcLuaMenuCommand, C.CURSOR_LOC, a1, 3313461902 --[[cursor]], 2, 2)   -- the list cursor stays off them
    return
  end
  PL.ssl_prev_setup_layer(a1, a2)
end

PL.ssl_prev_open_layer = OnOpenLayer
function OnOpenLayer(a1, a2)
  if a1 == PL.L_SSLIST or a1 == PL.L_SSROW or a1 == PL.L_LISTBG or a1 == PL.FILE_BTN.L then
    funcLuaMenuCommand(C.LAYER_VISIBLE, a1, a2, false)
    return
  end
  PL.ssl_prev_open_layer(a1, a2)
end

PL.MX_CMD = {FUSION_GET = 3115111780,
  FUSION_CLEAR = 1089030892}
-- (text ids)
PL.MX_TX = {ASSIGNED = 544123214 --[[skill_table_mx_assigned]], ASK_REMOVE = 1297342256 --[[skill_table_mx_ask_remove]]}
PL.MX_LAYER = 3679282495                         -- team00_30_aura_mixi_max_detail_info

function PL.mx_param(hdl)
  local ok, p = pcall(funcLuaCommand, 1131797651, hdl, 4)
  return ok and type(p) == "number" and to_u32(p) or 0
end

function PL.mx_chara_name(chara)
  local ok, a, b = pcall(funcLuaCommand, 4060384944, chara, 10)
  if ok and type(b) == "string" then
    return b
  elseif ok and type(a) == "string" then
    return a
  end
  return string.format("%08X", to_u32(chara or 0))
end

-- Says whether two cards sit in one team set (the bit field retail IsCharaInAnyTeam reads).
function PL.mx_shares_team(base, partner)
  local okb, base_sets = pcall(funcLuaCommand, 1131797651, base, 35)
  local okp, partner_sets = pcall(funcLuaCommand, 1131797651, partner, 35)
  if not okb or not okp or type(base_sets) ~= "number" or type(partner_sets) ~= "number" or base_sets == 0 or partner_sets == 0 then
    return false
  end
  for set = 0, 16 do
    if funcLuaCommand(3781690203 --[[CMND_CHECK_BIT]], base_sets, set) and funcLuaCommand(3781690203, partner_sets, set) then
      return true
    end
  end
  return false
end

-- Shows a pair's inactive reason on aura layer A: the text under the header and the retail alert icon; returns whether it shows one.
function PL.pair_warning(A, warning)
  if type(warning) ~= "string" or warning == "" then
    return false
  end
  funcLuaMenuCommand(C.TEXT, A, 2956552560 --[[_text_flavor02]], warning, 0)
  funcLuaMenuCommand(2735666188, A, 2956552560, true, 0)
  local icon = pcall(funcLuaMenuCommand, C.SPRITE, A, 2361962091 --[[cmn01_16]], 542418604 --[[icon_alert_yellow01]],
    4285917355 --[[icon_fs_area_dmy01]], 0, 0)
  pcall(Call, C.LOG, "skill_slots", "pair warning on layer", string.format("%08X", to_u32(A)), "alert icon", tostring(icon), warning)
  return true
end

-- Returns the fusion of the current player (the running fusion and the partner's handle).
function PL.mx_get()
  local h = PL.mx_test_hdl or n                    -- (mx_test_hdl: harness only, nil in game)
  if h == nil or h == 0 then
    return nil
  end
  local ok, exists, partner, m1, m2, chara, best, phdl, off_text, inactive_label, in_team_text =
    pcall(funcLuaCommand, PL.MX_CMD.FUSION_GET, h)
  if not ok or exists ~= true then
    return nil
  end
  local f = {partner = to_u32(partner or 0), move = to_u32(m1 or 0), move2 = to_u32(m2 or 0), chara = chara or 0,
    best = best == true or best == 1, phdl = type(phdl) == "number" and phdl or 0}
  -- the partner's face key (from 347353059(param), as the retail miximax window)
  local okk, face = pcall(funcLuaCommand, 347353059, f.partner)
  f.face = (okk and type(face) == "number" and face ~= 0) and face or f.chara
  -- Keeps the reason a stored fusion gives no miximax in a match: its validity, else a partner in the base's team.
  f.warning_label = type(inactive_label) == "string" and inactive_label or ""
  if type(off_text) == "string" and off_text ~= "" then
    f.warning = off_text
  elseif type(in_team_text) == "string" and in_team_text ~= "" and PL.mx_shares_team(h, f.phdl) then
    f.warning = in_team_text
  end
  return f
end

-- list rows of the three Miximax lists (the custom-passive list window, generic modes)
function PL.mx_row_base(L, k, e, selected)
  PL.row_full(L, k)
  for _, m in ipairs(PL.SSROW_HIDE) do
    funcLuaMenuCommand(C.MESH_VISIBLE, L, m, false, k)
  end
  funcLuaMenuCommand(C.MESH_VISIBLE, L, PL.SSROW_BASE_ON, selected, k)
  funcLuaMenuCommand(C.MESH_VISIBLE, L, PL.SSROW_BASE_OFF, not selected, k)
  local name = e.grey and ("[CGRAYOUT04]" .. e.name .. "[C]") or e.name
  funcLuaMenuCommand(C.TEXT, L, PL.SSROW_TEXT_ON, name, k)
  funcLuaMenuCommand(C.TEXT, L, PL.SSROW_TEXT_OFF, name, k)
  funcLuaMenuCommand(2735666188 --[[text visible]], L, PL.SSROW_TEXT_ON, selected, k)
  funcLuaMenuCommand(2735666188 --[[text visible]], L, PL.SSROW_TEXT_OFF, not selected, k)
  funcLuaMenuCommand(C.MESH_VISIBLE, L, 2164615260 --[[_icon_sp_area_dmy01]], false, k)
  funcLuaMenuCommand(C.MESH_VISIBLE, L, 2384755812 --[[_icon_sixth_dmy01]], false, k)
  funcLuaMenuCommand(C.MESH_VISIBLE, L, 2309656400 --[[_icon_check01]], e.check == true, k)
  funcLuaMenuCommand(POSITION_VISIBLE, L, 442049775 --[[_pos_equip01]], false, k)
  funcLuaMenuCommand(POSITION_VISIBLE, L, 3426045766 --[[_pos_have01]], e.num ~= nil, k)
  funcLuaMenuCommand(1233047821 --[[number visible]], L, k, 3974820126 --[[num_equip01]], false)
  funcLuaMenuCommand(1233047821 --[[number visible]], L, k, 3334923667 --[[num_have01]], e.num ~= nil)
  if e.num ~= nil then
    funcLuaMenuCommand(C.MESH_VISIBLE, L, 2037408502 --[[_icon_have01]], false, k)
    local idx = funcLuaMenuCommand(1927054058, L, k, 3334923667)
    if type(idx) == "number" and idx >= 0 then
      funcLuaMenuCommand(3609943765 --[[set number]], L, k, idx, e.num)
    end
  end
  funcLuaMenuCommand(C.MESH_VISIBLE, L, 1255155594 --[[_icon_cmd_type_dmy01]], false, k)
  funcLuaMenuCommand(C.MESH_VISIBLE, L, 2172872396 --[[_icon_cmd_type_base01]], false, k)
end

function PL.mx_clear()
  local base = PL.mx_param(n)
  local okc, cleared = pcall(funcLuaCommand, PL.MX_CMD.FUSION_CLEAR, n)
  if okc and cleared == true then
    local have = funcLuaCommand(PL.ITEM_NUM, PL.MX_FUSION)
    if type(have) == "number" and have > 0 then
      funcLuaCommand(PL.DEL_ITEM, PL.MX_FUSION, 1)
    end
  end
  pcall(Call, C.LOG, "skill_slots", "miximax clear", string.format("%08X", base))
  funcLuaCommand(C.SE, SE_REMOVE)
end

PL.MX_CREATE = 2771212752              -- "Crear miximax" (Character Reforged's create item, never equipped)
PL.MX_FUSION = 2450842569                     -- the fusion aura (the Hiper slot holds it)
PL.MX_KEY_DEL = 99760714            -- pick block: Eliminar on a list entry
PL.MX_KEY_PRIME = 2900901523          -- pick block: "Crear miximax" greyed (Prime base)
PL.MX_KEY_BASE = 1847499704            -- pick block: the base player's handle

-- Handles the Hiper picker's result.
PL.mx_prev_equip = CharacterReforged.skill_table_equip
function CharacterReforged.skill_table_equip(row, skill, inv_hint, cur)
  local del = VRFW.param.has(PL.MX_KEY_DEL)
  VRFW.param.clear(PL.MX_KEY_DEL)
  if row == 0 and del and skill == PL.MX_FUSION then
    PL.mx_clear()
    if Skill(0) == PL.MX_FUSION then
      CharacterReforged.skill_table_restore_coroutine(0)
    end
    return
  end
  return PL.mx_prev_equip(row, skill, inv_hint, cur)
end

PL.MX_SCENE_ON = true
PL.MX_CMD.SCENE = 2082559024             -- (base) -> ok, event, map | false, reason
PL.MX_CMD.SCENE_END = 2508340984        -- (why)
PL.MX_CMD.SCENE_STATE = 1383320350      -- () -> pending, base handle, seconds
-- The scene plays through the VRFW's live player (end hold off).
PL.MX_CMD.LIVE_RUN = 4161583144         -- (reservation, event) -> true, slot | false, why
PL.MX_CMD.LIVE_TICK = 2209917010        -- () -> phase, frame, total, ...
PL.MX_CMD.LIVE_CTL = 318578946          -- (op, n): "hold" 0 = play into the end
PL.MX_CMD.LIVE_WINDOW = 3960864664      -- (x, y, w, h, muted): w 0 = full screen
PL.MX_CMD.LIVE_VIEW = 1810537232        -- (zoom, pan x, pan y): 1, 0, 0 = the event's framing
PL.mx_scene_busy = false                -- the scene is on: this screen takes no input (the module's own flag, below)

-- run the reserved event `ev` -> pcall results (ok, true, slot | ok, false, why)
function PL.mx_scene_run(reserved, ev)
  pcall(funcLuaCommand, PL.MX_CMD.LIVE_WINDOW, 0, 0, 0, 0, 0)
  pcall(funcLuaCommand, PL.MX_CMD.LIVE_VIEW, 1, 0, 0)
  local ok, run, info = pcall(funcLuaCommand, PL.MX_CMD.LIVE_RUN, reserved, ev)
  if ok and run == true then
    pcall(funcLuaCommand, PL.MX_CMD.LIVE_CTL, "hold", 0)
  end
  return ok, run, info
end

function PL.mx_scene_tick()
  local ok, ph, frame, total = pcall(funcLuaCommand, PL.MX_CMD.LIVE_TICK)
  return ok, ph, (type(frame) == "number" and frame / 60 or nil), (type(total) == "number" and total / 60 or nil)
end

-- the framework's top bar is hidden while the scene plays (param vrfw_top_bar_hidden / VRFW.top_bar.hide)
function PL.mx_scene_top_bar(hide)
  if type(VRFW.top_bar.hide) == "function" then
    pcall(VRFW.top_bar.hide, hide)
  elseif hide then
    VRFW.param.set(1455983968 --[[vrfw_top_bar_hidden]], 1)
  elseif VRFW.param.has(1455983968) == true then
    VRFW.param.clear(1455983968)
  end
end
