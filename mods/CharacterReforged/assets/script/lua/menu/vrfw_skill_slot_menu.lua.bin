function PL.layout_loc(i)
  local l = PL.LAYOUT_LOCS[i]
  if l == nil then
    return nil
  end
  local mode = PL.layout_mode or nil
  if mode == "move" and l[6] ~= nil then
    return l[6], l[7]
  elseif mode ~= nil then
    return l[4], l[5]
  end
  return l[2], l[3]
end

function PL.apply_detail_layout()
  local mode = PL.layout_mode or nil
  if funcLuaMenuCommand(262659071, L_BASE) then
    for i, l in ipairs(PL.LAYOUT_LOCS) do
      local x, y = PL.layout_loc(i)
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_BASE, 0, l[1], 0, x)
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_BASE, 0, l[1], 1, y)
    end
  end
  local mv = mode == "move"
  local tr = mode == "training"
  local PP = PL.PLAIN
  local plx = PL.CARD_PLAIN[1] + PP.pad + PP.icon + PP.gap - PP.name_x      -- locator x that puts the name right of the icon
  if mode == "plain" and PL.LAYOUT_LOCS[1] ~= nil and funcLuaMenuCommand(262659071, L_BASE) then
    funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_BASE, 0, PL.LAYOUT_LOCS[1][1], 0, plx)
    funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_BASE, 0, PL.LAYOUT_LOCS[1][1], 1, -PP.loc_y)
  end
  local banner = tr or mode == "plain"            -- the band as the card's banner, the icon 64 px on its left
  if funcLuaMenuCommand(262659071, L_DETAIL) then
    for _, j in ipairs(PL.LAYOUT_TRN_NODES) do
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_DETAIL, 0, j[1], 0, banner and j[6] or j[2])
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_DETAIL, 0, j[1], 1, banner and j[7] or j[3])
      funcLuaMenuCommand(2885415772 --[[node scale]], L_DETAIL, 0, j[1], banner and j[8] or j[4], banner and j[9] or j[5])
    end
    local f = PL.LAYOUT_PLAIN_FLAVOR
    funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_DETAIL, 0, f[1], 0, f[2])         -- the description keeps its retail rect
    funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_DETAIL, 0, f[1], 1, f[3])
    funcLuaMenuCommand(2885415772 --[[node scale]], L_DETAIL, 0, f[1], f[4], f[5])
    if mode == "plain" then
      local x0, x1 = PL.CARD_PLAIN[1], PL.CARD_PLAIN[3]
      for _, band in ipairs({1125548721 --[[_sp_base01]], 3384915402 --[[_wlv_base01]]}) do
        funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_DETAIL, 0, band, 0, x0 - plx)
        funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_DETAIL, 0, band, 1, PP.band_y)
        funcLuaMenuCommand(2885415772 --[[node scale]], L_DETAIL, 0, band, x1 - x0 - PP.inset, PP.band_h)
      end
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_DETAIL, 0, 2164615260 --[[_icon_sp_area_dmy01]], 0, x0 + PP.pad - plx)
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_DETAIL, 0, 2164615260, 1, PP.icon_y)
      funcLuaMenuCommand(2885415772 --[[node scale]], L_DETAIL, 0, 2164615260, PP.icon, PP.icon)
      funcLuaMenuCommand(C.MESH_VISIBLE, L_DETAIL, PP.quote_line, false, 0)    -- the retail grey quote bar
    end
  end
  -- the left column's dark backing (L_BASE _list_base01) stays behind the training stat rows as on the move rows
  if funcLuaMenuCommand(262659071, PL.LAYOUT_TRN_PANEL) then
    for _, c in ipairs(PL.LAYOUT_TRN_CELLS) do
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, PL.LAYOUT_TRN_PANEL, 0, c[1], 0, tr and c[4] or c[2])
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, PL.LAYOUT_TRN_PANEL, 0, c[1], 1, tr and c[5] or c[3])
    end
  end
  if funcLuaMenuCommand(262659071, L_DETAIL_LV) then
    local k = mv and PL.LAYOUT_LV_SCALE or 1
    funcLuaMenuCommand(3778714801, L_DETAIL_LV, k, k, 1, 0)
  end
  if funcLuaMenuCommand(262659071, L_DETAIL) then
    for _, j in ipairs(PL.LAYOUT_MOVE_NODES) do
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_DETAIL, 0, j[1], 0, mv and j[4] or j[2])
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, L_DETAIL, 0, j[1], 1, mv and j[5] or j[3])
    end
  end
  local au = mode == "aura" or mode == "mx"
  local wins = {PL.L_AURA2}
  for _, A in pairs(PL.AURA_LAYER or {}) do
    wins[#wins + 1] = A
  end
  for _, A in ipairs(wins) do
    if funcLuaMenuCommand(262659071, A) then
      local y = 0
      if A == PL.L_AURA2 then
        y = PL.LAYOUT_AURA2_Y
      elseif au then
        y = PL.LAYOUT_AURA_DY
      end
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, A, 0, PL.LAYOUT_BASE_NODE, 0, au and PL.LAYOUT_AURA_DX or 0)
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, A, 0, PL.LAYOUT_BASE_NODE, 1, y)
    end
  end
  -- Handles an aura with a PEG or SP pool.
  if PL.POOL ~= nil and funcLuaMenuCommand(262659071, PL.L_HIPER) then
    local P = PL.POOL
    local pool = au and PL.pool_peg ~= nil
    for _, g in ipairs({{0, pool and P.MOVE_X or P.X, pool and P.K or 1}, {P.INST, P.POOL_X, P.K}}) do
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, PL.L_HIPER, g[1], P.NODE, 0, g[2])
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, PL.L_HIPER, g[1], P.NODE, 1, P.Y)
      funcLuaMenuCommand(2885415772 --[[node scale]], PL.L_HIPER, g[1], P.NODE, g[3], g[3])
    end
  end
  local pv = PL.LAYOUT_PV
  local pc = mode == "passive_custom"
  if funcLuaMenuCommand(262659071, PL.L_PV_DETAIL) then
    local P = PL.L_PV_DETAIL
    funcLuaMenuCommand(PL.LAYOUT_NODE_POS, P, 0, PL.LAYOUT_BASE_NODE, 0, pc and pv.dx or 0)
    funcLuaMenuCommand(PL.LAYOUT_NODE_POS, P, 0, PL.LAYOUT_BASE_NODE, 1, pc and pv.dy or 0)
    funcLuaMenuCommand(2885415772 --[[node scale]], P, 0, pv.flavor, pv.flavor_w, pc and pv.flavor_h_compact or pv.flavor_h)
    for k, b in ipairs(pv.builds) do
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, P, 0, b, 0, pc and pv.build_x_compact[k] or pv.build_x[k])
      funcLuaMenuCommand(PL.LAYOUT_NODE_POS, P, 0, b, 1, pc and pv.build_y_compact or pv.build_y)
    end
  end
  local H = CharacterReforged.PLAYER_PAGE_HOST
  if type(H) == "table" then
    if PL.card_default == nil and type(H.card) == "table" then
      PL.card_default = H.card
    end
    local key = mode == "mx" and "aura" or mode    -- one view at a time (R3), one row
    H.card = key ~= nil and PL.LAYOUT_CARD[key] or PL.card_default
  end
end

-- Sets the detail layout for a mode.
function PL.set_detail_layout(mode)
  PL.layout_mode = mode
  PL.layout_frames = mode ~= nil and PL.LAYOUT_FRAMES or 0
  PL.apply_detail_layout()
end

function PL.passive_board(item, name, effect)
  local L = PL.L_PV_DETAIL
  if item == nil or item == 0 or UpdateSixSenseDetailInfo == nil
      or not funcLuaMenuCommand(262659071, L) then
    return false
  end
  PL.detail_hide_all()
  PL.open(L)
  PL.open(PL.L_PV_BUILD, 0)
  PL.open(PL.L_PV_BUILD, 1)
  local info = funcLuaCommand(1448743477, 0, item)
  UpdateSixSenseDetailInfo(0, item, info, n)
  funcLuaMenuCommand(C.MESH_VISIBLE, L, 738777627, false, 0)   -- the card frame / shadow
  if type(name) == "string" and name ~= "" then   -- the passive's own name, not the slot label
    funcLuaMenuCommand(C.TEXT, L, PL.LAYOUT_PV.name, name, 0)
  end
  if type(effect) == "string" then                -- the effect lines alone (a signature passive's text holds its name)
    funcLuaMenuCommand(C.TEXT, L, PL.LAYOUT_PV.flavor, effect, 0)
    funcLuaMenuCommand(1505208242, L, PL.LAYOUT_PV.flavor, true, 0)
  end
  local card = type(CharacterReforged.player_page) == "table" and type(CharacterReforged.player_page.passive_card_fill) == "function"
  if not card then
    -- Handles the case without the player page's block (the card's look).
    local band = PL.PV_BAND[3317336303]
    funcLuaMenuCommand(C.SPRITE, L, PL.BANDS_TEX, band, 3317336303 --[[sixth_base01]], 0, 0)
  end
  funcLuaMenuCommand(C.LAYER_VISIBLE, L, 0, true)
  character_reforged_detail_on = true
  pcall(PL.set_detail_layout, "passive_custom")    -- the compact block as the moves
  if card then
    local lx, ly = PL.layout_loc(1)
    local pv = PL.LAYOUT_PV
    local display = {passive = item, name = name, effect = effect}
    local okc, err = pcall(CharacterReforged.player_page.passive_card_fill, L, 0, n, display, lx + pv.dx, -ly - pv.dy)
    if not okc then
      pcall(Call, C.LOG, "skill_slots", "own passive card failed", tostring(err))
    end
    for i = 0, 1 do
      funcLuaMenuCommand(C.LAYER_VISIBLE, PL.L_PV_BUILD, i, false)
    end
  end
  return true
end

-- Draws the passive detail with its effect.
function PL.passive_detail(name, desc, item, effect)
  local okb, shown = pcall(PL.passive_board, item, name, effect)
  if okb and shown then
    return
  end
  if not okb then
    pcall(Call, C.LOG, "skill_slots", "passive detail (board window) failed", tostring(shown))
  end
  -- Fallback when the layer does not exist.
  if not funcLuaMenuCommand(262659071, L_DETAIL) then
    error("no detail layer")
  end
  PL.detail_hide_all()
  for _, pos in ipairs(PL.DETAIL_MOVE_POS) do
    funcLuaMenuCommand(2158717427 --[[locator visible]], L_DETAIL, pos, false, 0)
  end
  for _, mesh in ipairs(PL.DETAIL_MOVE_MESH) do
    funcLuaMenuCommand(C.MESH_VISIBLE, L_DETAIL, mesh, false, 0)
  end
  for _, t in ipairs(PL.DETAIL_MOVE_TEXT) do
    funcLuaMenuCommand(2735666188 --[[text visible]], L_DETAIL, t, false, 0)
  end
  for _, pr in ipairs(PL.DETAIL_MOVE_PRIM) do
    funcLuaMenuCommand(1233047821 --[[number visible]], L_DETAIL, 0, pr, false)
  end
  for i = 1, 10 do
    funcLuaMenuCommand(C.MESH_VISIBLE, L_DETAIL, CALC_CRC(string.format("_tension_on%02d", i)), false, 0)
  end
  funcLuaMenuCommand(C.MESH_VISIBLE, L_DETAIL, 1125548721 --[[_sp_base01]], true, 0)
  funcLuaMenuCommand(C.SPRITE, L_DETAIL, PL.PARTS_TEX, PL.BAND[2], 243934124 --[[sp_base01]], 0, 0)
  funcLuaMenuCommand(C.TEXT, L_DETAIL, 1704438437 --[[_text_name01]], name, 0)
  funcLuaMenuCommand(C.TEXT, L_DETAIL, 691026122 --[[_text_flavor01]], desc, 0)
  funcLuaMenuCommand(C.LAYER_VISIBLE, L_DETAIL, 0, true)
  character_reforged_detail_on = true
end

-- Initialises the Hiper panel.
function CharacterReforged.hyper_card_init()
-- ===== EVT hiper_card BEGIN ===== (shared Hiper card component; docs/game/hiper/plate-hiper-page.md «Shared card»)
CharacterReforged.hyper_card = CharacterReforged.hyper_card or {}
CharacterReforged.hyper_card.SKILL_INFO = 2580586398       -- (skill, 13 aura type | 16 change skill | 11 cost)
CharacterReforged.hyper_card.MC_TYPE = 6
CharacterReforged.hyper_card.TEAM02 = 3964676290           -- #/menu/102_team/team02/team02_02/<LG>/team02_02.g4tx
CharacterReforged.hyper_card.SP_RGB = {0.32, 0.72, 1.0}
CharacterReforged.hyper_card.TENS_RGB = {0.99, 0.51, 0.0}
CharacterReforged.hyper_card.PEG_RGB = {0.72, 0.42, 1.0}   -- the PEG gauge / label / number tint (the match HUD's PEG purple)

function CharacterReforged.hyper_card.log(...)
  CharacterReforged.hyper_card.logger = CharacterReforged.hyper_card.logger or VRFW.logger.new("hiper_card")
  CharacterReforged.hyper_card.logger(...)
end

function CharacterReforged.hyper_card.aura_type(skill)
  local ok, t = funcLuaCommand(CharacterReforged.hyper_card.SKILL_INFO, skill or 0, 13)
  if ok and type(t) == "number" then
    return t
  end
  return nil
end

function CharacterReforged.hyper_card.is_mode_change(skill)
  return CharacterReforged.hyper_card.aura_type(skill) == CharacterReforged.hyper_card.MC_TYPE
end

CharacterReforged.hyper_card.BANDS = {
  [0] = {1716659057, 4284183243, 2287747677, 372824062, 1631577960},   -- fs_base     keshin
  [1] = {1742805750, 4276636492, 2314173402, 395046521, 1619844847},   -- fsa_base    keshin armed
  [2] = {3558327990, 1293850380, 974759834, 2759668281, 3547988655},   -- mixi_base   miximax
  [3] = {2619781135, 87024053, 1915277603, 3964421248, 2605413398},
  [4] = {1514509020, 3276587878, 3024876528, 707749459, 1562924741},   -- kizuna_base kizuna trans
  [5] = {4250578944, 1683218874, 324325676, 2368750735, 4197938201},   -- power_base  awakening power
  [6] = {3293713115, 1566262113, 710702071, 3023627860, 3275740866},   -- mode_base   mode change
}
-- Aura-type icon of the band's left slot (icon_common.g4tx onto icon_fs_area_dmy01).
CharacterReforged.hyper_card.TYPE_ICON = {[0] = 1815339204, 4114264446, 2185069032, 310549625, 1703259375, 88220938, 1917130140}
CharacterReforged.hyper_card.TEX_T30 = 2815298114         -- #/menu/102_team/team00/team00_30/<LG>/team00_30.g4tx

-- Returns the band sprite of an aura skill.
function CharacterReforged.hyper_card.band(skill)
  local t = CharacterReforged.hyper_card.aura_type(skill)
  local fam = t ~= nil and CharacterReforged.hyper_card.BANDS[t] or nil
  if fam == nil then
    return nil
  end
  local ok, e = funcLuaCommand(CharacterReforged.hyper_card.SKILL_INFO, skill, 7)
  if ok and e == 5 then
    local okc, common = funcLuaCommand(800895612, skill)
    if okc and common then
      e = 6
    end
  end
  local band = ok and type(e) == "number" and fam[e] or nil
  return band or fam[1]
end

-- Sets band, type icon and name on a team00_30 aura window (or its clone) instance.
function CharacterReforged.hyper_card.header(A, skill, name, inst)
  inst = inst or 0
  local band = CharacterReforged.hyper_card.band(skill)
  if band ~= nil then
    funcLuaMenuCommand(558735651, A, CharacterReforged.hyper_card.TEX_T30, band, 1716659057 --[[fs_base01]], 0, inst)
  end
  funcLuaMenuCommand(3405944500, A, 734954092 --[[_fs_base01]], true, inst)
  local t = CharacterReforged.hyper_card.aura_type(skill)
  local icon = t ~= nil and CharacterReforged.hyper_card.TYPE_ICON[t] or nil
  if icon ~= nil then
    funcLuaMenuCommand(558735651, A, 2320109963 --[[icon_common.g4tx]], icon, 4285917355 --[[icon_fs_area_dmy01]], 0, inst)
  end
  funcLuaMenuCommand(3405944500, A, 1605611365 --[[_icon_fs_area_dmy01]], icon ~= nil, inst)
  if type(name) == "string" then
    funcLuaMenuCommand(1083631230, A, 2915321899 --[[_text_fs01]], name, inst)
    funcLuaMenuCommand(2735666188, A, 2915321899, true, inst)
  end
  return icon
end

function CharacterReforged.hyper_card.desc(skill)
  local ok, id = funcLuaCommand(CharacterReforged.hyper_card.SKILL_INFO, skill, 5)
  if not ok or id == nil then
    return ""
  end
  local okt, s = pcall(funcLuaCommand, 4113915188, id)
  return (okt and type(s) == "string") and s or ""
end

function CharacterReforged.hyper_card.mc_ask(chara)
  local page = type(CharacterReforged) == "table" and CharacterReforged.page or nil
  if type(page) ~= "table" or type(page.mode_change_partner) ~= "function" then
    return false
  end
  local ok, pparam, pchara, phdl, label, in_team = pcall(page.mode_change_partner, chara)
  if ok and type(pparam) == "number" and pparam ~= 0 then
    return true, true, pparam, pchara, phdl, label, in_team
  end
  return false
end

function CharacterReforged.hyper_card.mc_get(chara, skill)
  if chara == nil or chara == 0 or not CharacterReforged.hyper_card.is_mode_change(skill) then
    return nil
  end
  local ok, exists, pparam, pchara, phdl, _, in_team = CharacterReforged.hyper_card.mc_ask(chara)
  if not ok or not exists or type(pparam) ~= "number" or pparam == 0 then
    return nil
  end
  local m = {chara = pchara or 0, phdl = type(phdl) == "number" and phdl or 0}
  -- Keeps the text that says a change gives no swap while its partner is in the base's team (empty when the rule allows it).
  m.in_team_text = type(in_team) == "string" and in_team or ""
  local okk, face = pcall(funcLuaCommand, 347353059, pparam)
  m.face = (okk and type(face) == "number" and face ~= 0) and face or m.chara
  local okn, a, b = pcall(funcLuaCommand, 4060384944, m.chara, 10)
  m.name = (okn and type(b) == "string" and b) or (okn and type(a) == "string" and a) or nil
  return m
end

function CharacterReforged.hyper_card.title(name, fusion, mc)
  if fusion ~= nil then
    return name or "Miximax Trans"
  end
  if mc ~= nil and mc.name ~= nil then
    return (name or "Modo cambio") .. ": " .. mc.name
  end
  return name
end

CharacterReforged.hyper_card.CHR_MESH, CharacterReforged.hyper_card.CHR_SLOT = 478320441, 3237726902
CharacterReforged.hyper_card.FS_MESH, CharacterReforged.hyper_card.FS_SLOT = 2449339029, 1051570875
function CharacterReforged.hyper_card.partner(A, face, ctx, inst)
  inst = inst or 0
  funcLuaMenuCommand(4176779611 --[[clear face icon]], A, inst, CharacterReforged.hyper_card.FS_SLOT)
  funcLuaMenuCommand(4176779611 --[[clear face icon]], A, inst, CharacterReforged.hyper_card.CHR_SLOT)
  funcLuaMenuCommand(3405944500 --[[MESH_VISIBLE]], A, CharacterReforged.hyper_card.FS_MESH, false, inst)
  if face == nil or face == 0 then
    funcLuaMenuCommand(3405944500, A, CharacterReforged.hyper_card.CHR_MESH, false, inst)
    return false
  end
  funcLuaMenuCommand(3405944500, A, CharacterReforged.hyper_card.CHR_MESH, true, inst)
  pcall(funcLuaCommand, 2996279796, ctx or "plate_page", face)
  local has = funcLuaMenuCommand(2208175668 --[[has a miximax face icon]], face)
  if has then
    funcLuaMenuCommand(346643487 --[[SwapLayerFaceIconTex]], A, inst, CharacterReforged.hyper_card.CHR_MESH, CharacterReforged.hyper_card.CHR_SLOT, face, 0, 12, true,
      true, true, 5)
  else
    VRFW.face_icon.request(A, inst, face, CharacterReforged.hyper_card.CHR_MESH, CharacterReforged.hyper_card.CHR_SLOT)
  end
  CharacterReforged.hyper_card.log("partner", tostring(A), tostring(face), tostring(has))
  return true
end

CharacterReforged.hyper_card.FACE_BY_TYPE = {[0] = {2449339029, 1051570875, 8}, [1] = {2449339029, 1051570875, 8},
  [2] = {478320441, 3237726902, 12}, [3] = {2449339029, 1051570875, 14}}
function CharacterReforged.hyper_card.portrait(A, skill, fusion, mc, ctx, inst)
  inst = inst or 0
  funcLuaMenuCommand(3405944500, A, CharacterReforged.hyper_card.FS_MESH, false, inst)
  funcLuaMenuCommand(3405944500, A, CharacterReforged.hyper_card.CHR_MESH, false, inst)
  funcLuaMenuCommand(4176779611 --[[clear face icon]], A, inst, CharacterReforged.hyper_card.FS_SLOT)
  funcLuaMenuCommand(4176779611 --[[clear face icon]], A, inst, CharacterReforged.hyper_card.CHR_SLOT)
  local partner = (fusion ~= nil and fusion.face) or (mc ~= nil and mc.face) or nil
  if fusion ~= nil or mc ~= nil then
    CharacterReforged.hyper_card.partner(A, partner, ctx, inst)
    return partner
  end
  local t = CharacterReforged.hyper_card.aura_type(skill)
  local face = t ~= nil and CharacterReforged.hyper_card.FACE_BY_TYPE[t] or nil
  local okc, cid = funcLuaCommand(CharacterReforged.hyper_card.SKILL_INFO, skill, 17)
  if okc and cid ~= nil and cid ~= 0 and face ~= nil then
    funcLuaMenuCommand(3405944500, A, face[1], true, inst)
    funcLuaMenuCommand(346643487 --[[SwapLayerFaceIconTex]], A, inst, face[1], face[2], cid, 0, face[3], true, true, true, 5)
    return cid
  end
  return nil
end

function CharacterReforged.hyper_card.aura_move(skill)
  if CharacterReforged.hyper_card.is_mode_change(skill) then
    return false, 0
  end
  local ok, move = funcLuaCommand(CharacterReforged.hyper_card.SKILL_INFO, skill, 16)
  if ok and type(move) == "number" and move ~= 0 then
    return true, move
  end
  local okl, kind, keshin = pcall(funcLuaCommand, CALC_CRC("CMND_CHARACTERREFORGED_SLOT_OF"), skill)
  if okl and kind == 2 and type(keshin) == "number" and keshin ~= 0 then
    local okk, km = funcLuaCommand(CharacterReforged.hyper_card.SKILL_INFO, keshin, 16)
    if okk and type(km) == "number" and km ~= 0 then
      return true, km
    end
  end
  return false, 0
end

function CharacterReforged.hyper_card.peg_info(aura)
  local ok, has, kind, pool, cost = pcall(funcLuaCommand, CALC_CRC("CMND_CHARACTERREFORGED_POINTS_PEG_INFO"), aura or 0)
  if ok and has == true and type(pool) == "number" and pool > 0 then
    return {kind = kind, pool = pool, cost = cost or 0}
  end
  return nil
end

function CharacterReforged.hyper_card.peg_look(L, inst, on, kind)
  local sp = on and kind == 2
  local c = on and (sp and CharacterReforged.hyper_card.SP_RGB or CharacterReforged.hyper_card.PEG_RGB) or CharacterReforged.hyper_card.TENS_RGB
  local ok1, r1 = pcall(funcLuaMenuCommand, 558735651, L, CharacterReforged.hyper_card.TEAM02, on and CALC_CRC(sp and "cr_tension_on_sp" or "cr_tension_on_peg") or CALC_CRC("tension_on01"),
    CALC_CRC("tension_on01"), 0, inst)
  local ok2, r2 = pcall(funcLuaMenuCommand, 558735651, L, CharacterReforged.hyper_card.TEAM02, on and CALC_CRC(sp and "cr_gtxt_sp_t" or "cr_gtxt_peg_t") or CALC_CRC("gtxt_t01"),
    CALC_CRC("gtxt_t01"), 0, inst)
  CharacterReforged.hyper_card.PEG_LOGS = (CharacterReforged.hyper_card.PEG_LOGS or 0) + 1
  if on and CharacterReforged.hyper_card.PEG_LOGS <= 8 then
    CharacterReforged.hyper_card.log("peg look", string.format("layer %s inst %s kind %s squares %s/%s T %s/%s", tostring(L), tostring(inst),
      tostring(kind), tostring(ok1), tostring(r1), tostring(ok2), tostring(r2)))
  end
  pcall(funcLuaMenuCommand, 558735651, L, CharacterReforged.hyper_card.TEAM02, CALC_CRC("gtxt_tension01"), CALC_CRC("gtxt_tension01"), 0, inst)
  funcLuaMenuCommand(3405944500, L, CALC_CRC("_gtxt_tension01"), not on, inst)
  funcLuaMenuCommand(3405944500, L, CALC_CRC("_tension_off01"), not on, inst)
  funcLuaMenuCommand(3405944500, L, CALC_CRC("_gtxt_t01"), true, inst)
  -- Keep the obsolete label transparent even if a parent show restores mesh visibility.
  pcall(funcLuaMenuCommand, 2219773080, L, inst, CALC_CRC("_gtxt_tension01"), on and 0 or 1)
  pcall(funcLuaMenuCommand, 2219773080, L, inst, CALC_CRC("_tension_off01"), on and 0 or 1)
  pcall(funcLuaMenuCommand, 855211291, L, inst, 3424269865 --[[number prim]], c[1], c[2], c[3])
  -- the number field's placeholder _num_tension_dmy01 off after every show of _pos_tension01
  funcLuaMenuCommand(3405944500, L, CALC_CRC("_num_tension_dmy01"), false, inst)
end

function CharacterReforged.hyper_card.pool_name(name, peg)
  if name == nil or peg == nil then
    return name
  end
  return string.format("%s  ·  %s %d", name, peg.kind == 2 and "SP" or "PEG", math.floor(peg.pool + 0.5))
end

function CharacterReforged.hyper_card.peg_pool(L, peg)
  pcall(funcLuaMenuCommand, 558735651, L, CharacterReforged.hyper_card.TEAM02, CALC_CRC("gtxt_cmd_at01"), CALC_CRC("gtxt_cmd_at01"), 0, 0)
  pcall(funcLuaMenuCommand, 855211291, L, 0, 2223127589, 1, 1, 1)
end

function CharacterReforged.hyper_card.steps(cost, scale)
  if type(cost) ~= "number" or scale == nil or scale <= 0 then
    return 0
  end
  return math.min(10, math.max(1, math.floor(cost / scale * 10 + 0.5)))
end
-- ===== EVT hiper_card END =====
end
CharacterReforged.hyper_card_init()
CharacterReforged.hyper_card_init = nil
PL.HIPER_PANEL = true
PL.AURA_LAYER = {[0] = 2651268807 --[[keshin]], 395833588 --[[keshin armed]], 3679282495 --[[mixi max]],
  576015315 --[[soul / totem]], 3635526425 --[[kizuna trans]], 1305553269 --[[awakening power]], 3131422953 --[[mode change]]}
-- the retail page that holds the description (_pos_page03 / _text_flavor02) for each aura type
PL.AURA_DESC_PAGE = {[0] = 2, 0, 1, 1, 0, 0, 0}
PL.AURA_HIDE_POS = {3407216458 --[[_pos_page01]], 1377611504 --[[_pos_page02]], 3145665477 --[[_pos_page04]],
  3430431571 --[[_pos_page05]], 1307475940 --[[_pos_list01]], 3571920478 --[[_pos_list02]]}
PL.AURA_HIDE_TEXT = {1179414078 --[[_text_fsp01]], 691026122 --[[_text_flavor01]], 1899787537 --[[_text_area01]],
  3542179801 --[[_text_page_title01]], 1244139107 --[[_text_page_title02]], 2739645270 --[[_text_page_title04]],
  3561790400 --[[_text_page_title05]], 777911507 --[[_text_flavor05]], 325360264 --[[_text_scr_btn01]],
  1757105749}
PL.AURA_HIDE_MESH = {3032210235, 206240291, 563708378 --[[_gtxt_cmd_at01]],
  3516146179 --[[_area_base01]], 811580556 --[[_gtxt_armed01]], 1013569271 --[[_ai_use01]], 4122450641,
  2992676399, 508629071, 4147295610, 2150991340,
  2269285990, 2408672862, 869298536, 4217713136,
  658945009, 905124895, 2370796410, 1956062673, 859266817,
  240613041, 380545388, 68880002, 3165086183, 561011038,
  4195885618, 3182975202, 2161668434, 855158082}
-- Clears both portrait slots of an aura window on every show.
function PL.face_reset(A)
  funcLuaMenuCommand(4176779611 --[[clear face icon]], A, 0, 1051570875 --[[icon_fs_dmy01]])
  funcLuaMenuCommand(4176779611 --[[clear face icon]], A, 0, 3237726902 --[[icon_chr_dmy01]])
end

function PL.aura_clean(A)
  for _, p in ipairs(PL.AURA_HIDE_POS) do
    funcLuaMenuCommand(2158717427 --[[locator visible]], A, p, false, 0)
  end
  for _, x in ipairs(PL.AURA_HIDE_TEXT) do
    funcLuaMenuCommand(2735666188 --[[text visible]], A, x, false, 0)
  end
  for _, m in ipairs(PL.AURA_HIDE_MESH) do
    funcLuaMenuCommand(C.MESH_VISIBLE, A, m, false, 0)
  end
  funcLuaMenuCommand(1233047821 --[[number visible]], A, 0, 2223127589, false)
  funcLuaMenuCommand(2158717427, A, 636603611, false, 0)
  funcLuaMenuCommand(C.MESH_VISIBLE, A, 443104220, false, 0)
end
