local GRAPH_LAYERS = {{2334590304, 1}, {32151736, 1}, {732343773, 7},   -- soccer11_07 radar, its base, 7 numbers
  {3665300474, 1}}                                 -- soccer11_16 rpg attack / defence param (the dark stat box)
