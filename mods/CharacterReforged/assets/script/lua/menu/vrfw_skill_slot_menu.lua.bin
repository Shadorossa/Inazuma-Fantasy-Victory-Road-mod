function PL.detail_restore()
  for _, m in ipairs(PL.MOVE_ROW_HIDE_MESH or {}) do      -- PL.move_as_row hid them on the last move
    funcLuaMenuCommand(C.MESH_VISIBLE, L_DETAIL, m, true, 0)
