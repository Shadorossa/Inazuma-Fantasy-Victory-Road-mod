PL.MX_SCENE_PRELOAD_MAX = 240          -- coroutine steps waiting for the model
-- Scene message duration in seconds.
PL.MX_SCENE_MSG = false
PL.MX_SCENE_MSG_AT = 3.75
PL.MX_SCENE_MSG_END = 5.05
